extends ../layout

block content 

  .container.mt-3 
    .row.justify-content-center 
      .col-md-8 
        h1.mb-4= title 

        if errors && errors.length > 0
          .alert.alert-danger 
            h5 Errores: 
            ul.mb-0 
              each error in errors 
                li= error.msg

        form(action=product && product._id ? `/admin/products/${product._id}/edit` : '/admin/products/create' , method="post", enctype='multipart/form-data')     
          .mb-3 
            label.form-label(for='title') Titulo 
            input.form-control#title(
                type="text"                
                name='title'
                value=product ? product.title : ''
                required
            )

          .mb-3 
            label.form-label(for='description') Descripcion 
            textarea.form-control#description(
                name="description"
                rows='5'
                required
            )=product ? product.description : ''

          .row 
            .col-md-6 
              .mb-3 
                label.form-label(for="price") Precio 
                input.form-control#price(
                    type="number"
                    name='price'
                    step='0.01'
                    min='0'
                    value=product ? product.price : ''
                    required
                )        

            .col-md-6 
              .mb-3 
                label.form-label(for="discount") Descuento (%)
                input.form-control#discount(
                  type="number"
                  name="discount"
                  min='0'
                  max='99'
                  value=product ? product.discount : '0'
                )

          .mb-3 
            label.form-label Plataformas 
            .form-check 
              each plataform in platforms
                .form-check 
                  input.form-check-input(
                    type="checkbox"
                    id=`platform_${plataform}`
                    name='platform'
                    value=plataform 
                    checked=(product && product.platform && Array.isArray(product.platform) && product.platform.includes(plataform) ? true : false)
                  )
                  label.form-check-label(for=`platform_${plataform}`)= plataform 

          hr.my-4
          h4.mb-3 📸 Imágenes del Producto
          
          .row
            //- Thumbnail
            .col-md-4
              .mb-3
                label.form-label Miniatura (Thumbnail)
                input.form-control(type='file' name='thumbnail' accept='image/*')
                small.text-muted Para el catálogo (800x600)
                
                if product && product.images && product.images.thumbnail && !product.images.thumbnail.url.includes('placeholder')
                  .mt-2
                    p.small.mb-1 Imagen actual:
                    img.img-thumbnail(src=product.images.thumbnail.url alt='Thumbnail' style='max-width: 150px;')
                    .form-check.mt-1
                      input.form-check-input(type='checkbox' name='deleteThumbnail' id='deleteThumbnail')
                      label.form-check-label(for='deleteThumbnail') Eliminar imagen actual
            
            //- Cover
            .col-md-4
              .mb-3
                label.form-label Portada (Cover)
                input.form-control(type='file' name='cover' accept='image/*')
                small.text-muted Para la página de detalle (800x600)
                
                if product && product.images && product.images.cover && !product.images.cover.url.includes('placeholder')
                  .mt-2
                    p.small.mb-1 Imagen actual:
                    img.img-thumbnail(src=product.images.cover alt='Cover' style='max-width: 150px;')
                    .form-check.mt-1
                      input.form-check-input(type='checkbox' name='deleteCover' id='deleteCover')
                      label.form-check-label(for='deleteCover') Eliminar imagen actual
            
            //- Screenshots
            .col-md-4
              .mb-3
                label.form-label Screenshots (hasta 5)
                input.form-control(type='file' name='screenshots' accept='image/*' multiple)
                small.text-muted Galería de imágenes
                
                if product && product.images && product.images.screenshots && product.images.screenshots.length > 0
                  .mt-2
                    p.small.mb-1 Screenshots actuales:
                    .row.g-2
                      each screenshot, index in product.images.screenshots
                        .col-6
                          img.img-thumbnail(src=screenshot alt=`Screenshot ${index + 1}` style='max-width: 100px;')
                          .form-check.mt-1
                            input.form-check-input(type='checkbox' name='deleteScreenshots' value=screenshot)
                            label.form-check-label.small Eliminar
          
          .alert.alert-info.mt-3
            strong 💡 Consejos:
            ul.mb-0.small
              li Si no subes nuevas imágenes, se mantienen las actuales
              li Formatos permitidos: JPG, PNG, WEBP
              li Peso máximo: 5MB por imagen

          .mb-3
            label.form-label(for="genre") Generos 
            select.form-select#genre(
              name='genre'
              multiple
            )
              each g in ['Action', 'RPG', 'Strategy', 'Adventure', 'Shooter', 'Sports', 'Racing', 'Indie', 'Simulation']
                option(value=g selected=(product && product.genre && product.genre.includes(g)))= g

          .row 
            .col-md-6 
              .mb-3 
                label.form-label(for='publisher') Publicador 
                input.form-control#publisher(
                  type='text'
                  name='publisher'
                  value= product ? product.publisher : ''
                )

            .col-md-6
              .mb-3 
                label.form-label(for='developer') Desarrollador 
                input.form-control#developer(
                  type="text"
                  name='developer'
                  value= product ? product.developer : ''
                )

          .row 
            .col-md-6 
              .mb-3 
                label.form-label(for="releaseDate") Fecha de lanzamiento 
                input.form-control#releaseDate(
                  type='date'
                  name='releaseDate'
                  value=(product && product.releaseDate ? (typeof product.releaseDate === 'string' ? product.releaseDate.split('T')[0] : product.releaseDate.toISOString().split('T')[0]) : '')
                  )     

            .col-md-6 
              .mb-3 
                label.form-label(for='stock') Stock Inicial 
                input.form-control#stock(
                  type='number'
                  name='stock'
                  min='0'
                  value=product ? product.stock : '0'
                )                              

          .mb-3
            label.form-label(for='tags') Tags 
            input.form-control#tags(
              type='text'
              name='tags'
              placeholder='Ej: open-world, ofertas, liquidación'
              value=product && product.tagsString ? product.tagsString : ''
            )

          .mb-3.form-check 
            input.form-check-input#featured(
              type='checkbox'
              name='featured'
              checked=product && product.featured
            ) 
            label.form-check-label(for='featured') Destacar este Producto 

          .d-flex.gap-2 
            button.btn.btn-primary.w-100.mt-2(type='submit')=product && product._id  ? 'Actualizar Producto' : 'Crear Producto'
            a.btn.btn-secondary.w-100.mt-2(href='/admin/products') Cancelar  

            

